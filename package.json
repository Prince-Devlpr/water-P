{
  "name": "smart-water-backend",
  "version": "1.0.0",
  "description": "Smart Water Level Management Backend with ESP8266, HiveMQ Cloud, Node.js, Express, PostgreSQL, Prisma, and Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "dev:broker": "node scripts/dev_broker.js",
    "simulate:esp": "node scripts/simulate_esp8266.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "iot",
    "esp8266",
    "ultrasonic",
    "water-level",
    "mqtt",
    "hivemq",
    "express",
    "prisma",
    "postgresql",
    "render",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mqtt": "^5.10.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "aedes": "^0.51.2",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

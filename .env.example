# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=*

# ==========================================
# PostgreSQL Database (Render or Local)
# ==========================================
# Local development example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartwater?sslmode=disable"
# Render Managed PostgreSQL example (with SSL):
# DATABASE_URL="postgresql://user:password@dpg-xxxx.render.com/smartwater?sslmode=require"

# ==========================================
# MQTT Broker (HiveMQ Cloud Free Cluster or Local)
# ==========================================
# HiveMQ Cloud Free Cluster (TLS Port 8883):
# MQTT_BROKER_URL="mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883"
# MQTT_USERNAME="your_hivemq_username"
# MQTT_PASSWORD="your_hivemq_password"

# Local / Dev Broker (Port 1883):
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET="smartwater_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"
